JWT_SECRET=your-256-bit-secret-key-here

FRONTEND_URL=https://hire-nest-iota.vercel.app

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

GITHUB_CLIENT_ID=your-github-client-id
GITHUB_CLIENT_SECRET=your-github-client-secret

# Cloudinary — PDF resume + profile photo uploads
# Dashboard: https://console.cloudinary.com → verify email → Settings → API Keys
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# If Cloudinary shows "cloud_name is disabled": verify email at cloudinary.com first.
# Temporary workaround on Render until Cloudinary works:
# UPLOAD_PROVIDER=local
# PUBLIC_URL=https://hirenest-cdb2.onrender.com
# Optional overrides
# CLOUDINARY_RESUME_FOLDER=hirenest/resumes
# CLOUDINARY_IMAGE_FOLDER=hirenest/profiles
# CLOUDINARY_RESUME_MAX_SIZE_MB=5

SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/hirenest?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=root
SPRING_DATASOURCE_PASSWORD=your-password
